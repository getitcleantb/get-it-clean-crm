rules_version = '2';
// Get It Clean CRM: only the owner and the crew the owner adds (Settings > Account) can read or change anything.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && email() == 'getitclean.tb@gmail.com'; }
    function isCrew() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(email()))
        && get(/databases/$(database)/documents/members/$(email())).data.uid == request.auth.uid;
    }
    function isTeam() { return isOwner() || isCrew(); }

    match /members/{memberEmail} {
      allow read: if isOwner() || (isCrew() && memberEmail == email());
      allow write: if isOwner();
    }
    match /profiles/{userId} {
      allow read: if isTeam();
      allow write: if isTeam() && request.auth.uid == userId;
    }
    match /{coll}/{docId} {
      allow read, write: if isTeam() && coll in ['leads', 'quotes', 'jobs', 'expenses'];
    }
    // texts: crew can queue a text typed in the CRM (sent by the owner's texting script), mark texts read, and take back
    // one of their own that's still waiting. Nobody can mark a text canceled once the script has picked it up.
    match /texts/{docId} {
      function canceling() { return request.resource.data.get('status', '') == 'cancelled' && resource.data.get('status', '') != 'cancelled'; }
      function cancelOk() { return !canceling() || resource.data.get('status', '') == 'queued'; }
      function crewNew() {
        let d = request.resource.data;
        return d.keys().hasOnly(['kind', 'phone', 'dir', 'body', 'at', 'status', 'leadId', 'by', 'unread', 'drip'])
          && d.kind == 'text' && d.dir == 'out' && d.status == 'queued' && d.by == request.auth.uid
          && d.phone is string && d.phone.size() <= 20 && d.body is string && d.body.size() <= 1500;
      }
      function crewChange() {
        let ch = request.resource.data.diff(resource.data).affectedKeys();
        return ch.hasOnly(['unread', 'retriedAs'])
          || (ch.hasOnly(['status']) && canceling() && resource.data.get('by', '') == request.auth.uid);
      }
      allow read: if isTeam();
      allow create: if isOwner() || (isCrew() && crewNew());
      allow update: if (isOwner() || (isCrew() && crewChange())) && cancelOk();
      allow delete: if isOwner();
    }
    // email and text blasts (settings/blast*) are the owner's: crew can see them but not start or change them,
    // or save another settings document dressed up as one
    match /settings/{docId} {
      allow read: if isTeam();
      allow create, update: if isOwner() || (isCrew() && !docId.matches('blast.*')
        && !(request.resource.data.get('kind', '') in ['blast', 'blastrun', 'blastout', 'sender', 'pause', 'textblast', 'textrun', 'textout', 'textsender']));
      allow delete: if isOwner() || (isCrew() && !docId.matches('blast.*'));
    }
    // the texting service's key: only the owner (and the owner's texting script) can see it
    match /private/{docId} {
      allow read, write: if isOwner();
    }
    // lets the CRM check these rules are published
    match /rulesv/{v} {
      allow read: if isTeam() && v in ['blasts1', 'texts1'];
    }
  }
}
